# =============================================================================
# ScamTrace Frontend Dashboard - Environment Configuration
# =============================================================================
# Copy this file to .env before starting the development server:
#   cp .env.example .env

# Component C1: URL & Domain Analyzer Backend URL
VITE_C1_URL=http://localhost:8001

# API Gateway URL (Optional, for consolidated scans and auth)
VITE_GATEWAY_URL=http://localhost:5000

# Other Component Analyzer Services (Optional)
VITE_C2_URL=http://localhost:8002
VITE_C3_URL=http://localhost:8003
VITE_C4_API_BASE_URL=http://localhost:8000/api/v1
