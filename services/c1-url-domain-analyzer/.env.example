# =============================================================================
# Component C1: Intelligent URL & Domain Analyzer - Environment Configuration
# =============================================================================
# Copy this file to .env before starting the microservice:
#   cp .env.example .env       (macOS / Linux)
#   copy .env.example .env     (Windows Command Prompt)
#   Copy-Item .env.example .env (Windows PowerShell)

# -----------------------------------------------------------------------------
# 1. Microservice Networking & Service Identification
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
PORT=8001
HOST=0.0.0.0
C1_SERVICE_NAME=c1-url-domain-analyzer
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# 2. Machine Learning Model Directory
# -----------------------------------------------------------------------------
# Path to directory containing best_model.joblib and preprocessor.joblib.
# If left commented or relative, it resolves to ./models relative to C1 root.
# MODEL_DIR=models

# -----------------------------------------------------------------------------
# 3. Optional Database Persistence (MongoDB)
# -----------------------------------------------------------------------------
# If MongoDB is not running, C1 gracefully runs in standalone in-memory mode.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=url_domain_analyzer

# -----------------------------------------------------------------------------
# 4. Domain Intelligence & Registration Thresholds (Contribution 2)
# -----------------------------------------------------------------------------
NRD_THRESHOLD_DAYS=30
NRD_WARNING_THRESHOLD_DAYS=90
DNS_TIMEOUT_SECONDS=3.0
RDAP_TIMEOUT_SECONDS=5.0
CACHE_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# 5. Optional External Threat Intelligence API Keys
# -----------------------------------------------------------------------------
# Leave empty to operate in local/offline heuristic and ML mode (recommended for offline dev).
VIRUSTOTAL_API_KEY=
THREATFOX_API_KEY=
