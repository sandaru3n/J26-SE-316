README.md

# Dataset images: may be large or contain suspicious material, keep out of Git.
# Folder placeholders (.gitkeep) stay tracked. Annotation JSON/JSONL files are
# small text records and are intentionally NOT ignored.
data/raw/*
data/processed/*
data/rejected/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/rejected/.gitkeep
data/annotations/*.tmp
